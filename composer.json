{
  "name": "h4kuna/critical-cache",
  "type": "library",
  "description": "Only one process can to write or to delete to cache.",
  "license": "MIT",
  "authors": [
    {
      "name": "Milan Matějček",
      "email": "milan.matejcek@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "h4kuna/data-type": "^3.0.15",
    "psr/clock": "^1.0",
    "psr/simple-cache": "^3.0"
  },
  "require-dev": {
    "beste/clock": "^3.0",
    "h4kuna/dir": "^0.1.7",
    "nette/caching": "^3.3.1",
    "nette/tester": "^2.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "shipmonk/coding-standard": "^0.2",
    "symfony/lock": "^6.4 || ^7.0 || ^8.0",
    "tracy/tracy": "^2.9"
  },
  "autoload": {
    "psr-4": {
      "h4kuna\\CriticalCache\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "h4kuna\\CriticalCache\\Tests\\": "tests/src"
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "scripts": {
    "cbf": "vendor/bin/phpcbf",
    "coverage": "vendor/bin/tester --coverage coverage.html --coverage-src src/ --colors 1 -s -C tests/src",
    "cs": "vendor/bin/phpcs",
    "qa": [
      "@tests",
      "@cs",
      "@stan"
    ],
    "stan": "vendor/bin/phpstan analyse",
    "tests": "vendor/bin/tester --colors 1 -s -C tests/src"
  },
  "suggest": {
    "symfony/lock": "As default implementation of the critical section.",
    "h4kuna/dir": "Default lock and cache need to create directories.",
    "nette/caching": "As default implementation for Cache for PSR-16."
  }
}
